<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Acción del wizard -->
  <record id="action_bhe_mail_wizard" model="ir.actions.act_window">
    <field name="name">Enviar por correo (SimpleAPI)</field>
    <field name="res_model">bhe.mail.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Botón en el header del form de boleta -->
  <record id="view_boleta_honorarios_form_inherit_mail_button" model="ir.ui.view">
    <field name="name">boleta.honorarios.form.inherit.mail.button</field>
    <field name="model">boleta.honorarios</field>
    <field name="inherit_id" ref="integracion_simple_api.view_boleta_honorarios_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="%(action_bhe_mail_wizard)d"
                type="action"
                string="Enviar por correo"
                class="btn-secondary"/>
      </xpath>
    </field>
  </record>

</odoo>