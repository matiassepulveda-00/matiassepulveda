<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Form del wizard -->
  <record id="view_bhe_mail_wizard_form" model="ir.ui.view">
    <field name="name">bhe.mail.wizard.form</field>
    <field name="model">bhe.mail.wizard</field>
    <field name="arch" type="xml">
      <form string="Enviar por correo (SimpleAPI)">
        <group>
          <field name="email" required="1"/>
          <field name="wait_seconds"/>
        </group>
        <footer>
          <button string="Enviar" type="object" name="action_send" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Acción del wizard (normalmente no la llamamos directa, pero es útil tenerla) -->
  <record id="action_bhe_mail_wizard" model="ir.actions.act_window">
    <field name="name">Enviar por correo (SimpleAPI)</field>
    <field name="res_model">bhe.mail.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{}</field>
  </record>

  <!-- Botón en el header del formulario de boleta -->
  <record id="view_boleta_honorarios_form_inherit_mail" model="ir.ui.view">
    <field name="name">boleta.honorarios.form.inherit.mail</field>
    <field name="model">boleta.honorarios</field>
    <!-- OJO: referencia al ID REAL de tu form base -->
    <field name="inherit_id" ref="integracion_simple_api.view_boleta_honorarios_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_mail_wizard"
                type="object"
                string="Enviar por correo"
                class="btn-secondary"/>
      </xpath>
    </field>
  </record>

</odoo>